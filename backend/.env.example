# ---------------------------------------------------------------------------
# MedHelp backend configuration. Copy to ".env" (local) or set these in your host's secret manager.
# ---------------------------------------------------------------------------

# REQUIRED ------------------------------------------------------------------
GROQ_API_KEY=                      # https://console.groq.com/keys (free plan)
QDRANT_URL=https://YOUR-CLUSTER-ID.REGION.cloud.qdrant.io:6333
QDRANT_API_KEY=

# Query-time embeddings through Cloudflare Workers AI (same bge-large model that built your index)
EMBED_PROVIDER=cloudflare          # cloudflare | local   (local needs requirements-ingest.txt and ~2 GB RAM)
CLOUDFLARE_ACCOUNT_ID=             # dash.cloudflare.com -> Workers AI -> "Use REST API"
CLOUDFLARE_API_TOKEN=              # token with the "Workers AI" permission

# STRONGLY RECOMMENDED on a public deployment: shared secret between frontend and API (X-API-Key header)
# generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# OPTIONAL (defaults shown) ---------------------------------------------------
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b        # jargon definitions, follow-up suggestions, query rewriting
# GROQ_REASONING_EFFORT=low
# GROQ_MAX_TOKENS=2048
# ANSWER_STYLE=helpful                      # helpful | strict

# Retrieval (unchanged from the original project)
# TOP_K=6
# RETRIEVE_CANDIDATES=16
# CONTEXT_CHAR_BUDGET=11000
# LEXICAL_TOP_K=8
# MIN_SIMILARITY=0.25
# HISTORY_MESSAGES=6
# KEYWORD_DB_PATH=data/keyword.sqlite.gz    # built by ingestion; rebuilt from Qdrant automatically if missing/stale

# Sessions (server-side chat history, per browser tab)
# SESSION_TTL_MINUTES=120
# SESSION_MAX=500
# SESSION_MAX_TURNS=20

# Fair use on free tiers
# RATE_LIMIT_PER_MINUTE=6                   # questions per session/IP per minute (0 = off)
# MAX_CONCURRENT_QUERIES=3                  # answered at once; the rest wait up to QUEUE_WAIT_SECONDS
# QUEUE_WAIT_SECONDS=25

# Answer cache (near-identical questions skip the LLM)
# CACHE_ENABLED=true
# CACHE_SIMILARITY=0.97                     # lower = more hits, more risk of a wrong match
# CACHE_MAX_ENTRIES=300
# CACHE_TTL_MINUTES=720

# Features
# FOLLOWUPS=true                            # suggested follow-up questions (one extra fast-model call)
# VERIFY_CITATIONS=true                     # local citation check (no extra call)
# RERANK_PROVIDER=none                      # none | voyage
# VOYAGE_API_KEY=                           # only with RERANK_PROVIDER=voyage (free plan: 3 requests/minute without a card)
# RERANK_CANDIDATES=12
# GROQ_STT_MODEL=whisper-large-v3-turbo     # voice questions
# STT_LANGUAGE=en                           # blank = auto-detect
# MAX_AUDIO_BYTES=2000000

# QDRANT_COLLECTION=medrag_guidelines    # keep this spelling: it is the name of your EXISTING collection in Qdrant
# LOG_LEVEL=INFO
